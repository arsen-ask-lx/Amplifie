#!/usr/bin/env sh
# Отметка «коммит дописывается» для проверки цикла (task-116).
#
# ЗАЧЕМ. При `--amend` индекс сравнивается git-ом со СТАРЫМ коммитом, и
# хук `commit-msg` видит только добавку: тест, лежащий в исходном коммите,
# для него «пропал». Хук `commit-msg` сам не знает, что идёт amend, — знает
# только этот: git передаёт ему источник `commit` и имя коммита — при
# `--amend --no-edit` это буквально слово HEAD (проверено 26.09 в песочнице).
# При `--amend -m` источник уже `message`, и отметки нет: там amend узнаётся
# по дате автора (см. `check-cycle.mjs`). Отметку снимает `check-cycle.mjs`.
if [ "$2" = "commit" ] && { [ "$3" = "HEAD" ] || [ "$3" = "$(git rev-parse HEAD 2>/dev/null)" ]; }; then
  : > "$(git rev-parse --git-dir)/amplifie-amend"
fi
exit 0
