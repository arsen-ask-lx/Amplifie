#!/usr/bin/env sh
# Карта проекта не отстаёт от коммита.
#
# ⚠️ ИМЕННО `commit-msg`, А НЕ `pre-commit`. Проверке нужны две вещи разом:
# что лежит в индексе и что человек написал в сообщении. У `pre-commit`
# сообщения ещё нет вовсе, значит не было бы и честного отказа с причиной —
# остался бы только `--no-verify`, то есть выход без следа.
#
# Индекс на этом шаге ещё собран, поэтому `git diff --cached` показывает
# ровно тот коммит, который сейчас делается.
#
# Хук включается `make hooks` (и сам при `make env`): git не берёт хуки
# из репозитория без `core.hooksPath`.
exec node tools/checks/check-map.mjs --staged "$1"
