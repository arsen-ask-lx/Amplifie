#!/usr/bin/env sh
# Карта проекта и цикл «план — тест — спека — ревью» не отстают от коммита.
#
# ⚠️ ИМЕННО `commit-msg`, А НЕ `pre-commit`. Проверкам нужны две вещи разом:
# что лежит в индексе и что человек написал в сообщении. У `pre-commit`
# сообщения ещё нет вовсе, значит не было бы и честного отказа с причиной —
# остался бы только выход без следа.
#
# ⚠️ ОБЕ ПРОВЕРКИ ИДУТ ВСЕГДА, КОД ОБЩИЙ (task-116). Прежде здесь стоял
# `exec` одной проверки: вторая строка после него не выполнилась бы, а
# человек чинил бы недостающее по одному пункту за коммит.
#
# Хук включается `make hooks` (и сам при `make env`): git не берёт хуки
# из репозитория без `core.hooksPath`.
#
# Третья — ревью было по-настоящему (task-124): по записи сессии агента правила
# `ocr` по каждому файлу и подагент после них. Только здесь: CI записи не видит.
#
# Отметку `--amend` от `prepare-commit-msg` снимает хук, а не проверка: она нужна всем
# трём, и после любого исхода оставлять её нельзя — следующий коммит счёлся бы дописыванием.
status=0
node tools/checks/check-map.mjs --staged "$1" || status=1
node tools/checks/check-cycle.mjs --staged "$1" || status=1
node tools/agent/review-audit.mjs "$1" || status=1
rm -f "$(git rev-parse --git-dir)/amplifie-amend"
exit $status
