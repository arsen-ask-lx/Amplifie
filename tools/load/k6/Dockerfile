# Без `# syntax=`: особых возможностей BuildKit здесь нет, а строка тянула бы описание
# синтаксиса из сети на каждую сборку — и `make k6-sse` падал без интернета (27.09).
# k6 с расширением потока (xk6-sse) — только для замера доставки (task-122, Р-051).
# Версии закреплены: чужой сборке «на лету» (автоматическое разрешение
# расширений k6 2.x) на машине владельца не место.
FROM grafana/xk6:1.4.14@sha256:2bf2f319554253656a00fa9224bc7b40bc401e45b9f04041074d62e39561c084 AS build
RUN xk6 build v2.3.0 --with github.com/phymbert/xk6-sse@v0.2.0 --output /tmp/k6

FROM grafana/k6:2.3.0@sha256:9c2dee7f8ed74d317e4027c06a10f169b625638189de8d4555d0b3486a5aeb34
COPY --from=build /tmp/k6 /usr/bin/k6
