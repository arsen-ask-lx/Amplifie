{
  "name": "amplifie",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --build && tsc -p apps/web --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "arch": "depcruise apps --config .dependency-cruiser.cjs",
    "decisions": "node scripts/check-decisions.mjs",
    "contrast": "node scripts/check-contrast.mjs",
    "unit": "vitest run --config vitest.unit.config.ts",
    "no-raw-html": "node scripts/check-no-raw-html.mjs",
    "model": "node scripts/check-model.mjs",
    "gates": "node scripts/run-gates.mjs",
    "arbiter:check": "node --test arbiter/*.test.mjs",
    "arbiter": "node arbiter/report.mjs",
    "label": "node arbiter/label.mjs",
    "test": "vitest run",
    "bridge": "tsc --build apps/bridge && node apps/bridge/dist/main.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "dependency-cruiser": "17.0.1",
    "drizzle-kit": "0.31.10",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
