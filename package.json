{
  "name": "amplifie",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --build && tsc -p apps/web --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "arch": "depcruise apps --config .dependency-cruiser.cjs",
    "decisions": "node scripts/check-decisions.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "dependency-cruiser": "17.0.1",
    "drizzle-kit": "0.31.10",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
