{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!dock",
      "!tools/gates",
      "!**/migrations/meta",
      "!test-results",
      "!playwright-report"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noConsole": "error",
        "noExplicitAny": "error",
        "noEmptyBlockStatements": "error"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 10
          }
        }
      },
      "correctness": {
        "noUnusedVariables": "error"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "tools/checks/**",
        "tools/arbiter/**",
        "tools/ops/**",
        "tools/dev/**",
        "tools/load/**",
        "bridge/**",
        "backend/src/migrate.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": [
        "backend/**",
        "packages/**",
        "bridge/**",
        "frontend/**",
        "tools/**",
        "playwright.config.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": {
                "requireAscii": true,
                "strictCase": false,
                "conventions": [
                  {
                    "selector": {
                      "kind": "objectLiteralProperty"
                    },
                    "formats": ["camelCase", "CONSTANT_CASE", "PascalCase", "snake_case"]
                  },
                  {
                    "selector": {
                      "kind": "typeProperty"
                    },
                    "formats": ["camelCase", "CONSTANT_CASE", "PascalCase", "snake_case"]
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "backend/src/agent/answering/envelope.ts",
        "backend/src/agent/answering/envelope.test.ts",
        "backend/tests/task-from-chat.e2e.test.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": [
        "frontend/src/app/ChannelAsks.tsx",
        "frontend/src/app/InviteDialog.tsx",
        "frontend/src/app/ProjectDialog.tsx",
        "frontend/src/app/ProjectRow.tsx",
        "frontend/src/app/RoomList.tsx",
        "frontend/src/screens/AuthScreen.tsx",
        "frontend/src/screens/JoinScreen.tsx",
        "frontend/src/screens/agents/KeyPanel.tsx",
        "frontend/src/screens/agents/ModelScreen.tsx",
        "frontend/src/screens/entry/EntryFrame.tsx",
        "frontend/src/screens/entry/pictures.ts",
        "frontend/src/screens/talk/Corner.tsx",
        "frontend/src/shared/Icon.tsx",
        "frontend/src/shared/clipboard.ts",
        "frontend/src/shared/projectLook.tsx",
        "frontend/src/shared/projectLookNames.ts",
        "frontend/src/shared/theme.ts",
        "frontend/src/shared/when.ts",
        "frontend/tests/ui/projects.spec.ts",
        "tools/checks/check-contrast.mjs"
      ],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off"
          }
        }
      }
    }
  ]
}
