{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!dock",
      "!tools/gates",
      "!**/migrations/meta",
      "!backend/openapi.json",
      "!test-results",
      "!playwright-report"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noConsole": "error",
        "noExplicitAny": "error",
        "noEmptyBlockStatements": "error"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 10
          }
        }
      },
      "correctness": {
        "noUnusedVariables": "error"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "tools/checks/**",
        "tools/arbiter/**",
        "tools/ops/**",
        "tools/dev/**",
        "tools/load/**",
        "tools/agent/**",
        "bridge/**",
        "backend/src/migrate.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": [
        "backend/**",
        "packages/**",
        "bridge/**",
        "frontend/**",
        "tools/**",
        "playwright.config.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": {
                "requireAscii": true,
                "strictCase": false,
                "conventions": [
                  {
                    "selector": {
                      "kind": "objectLiteralProperty"
                    },
                    "formats": ["camelCase", "CONSTANT_CASE", "PascalCase", "snake_case"]
                  },
                  {
                    "selector": {
                      "kind": "typeProperty"
                    },
                    "formats": ["camelCase", "CONSTANT_CASE", "PascalCase", "snake_case"]
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
