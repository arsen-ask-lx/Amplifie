# Дев-конфиг. TLS появится вместе с доменом — Caddy возьмёт сертификат сам.
#
# ⚠️ ИНЦИДЕНТ 2026-09-04, из-за которого этот файл выглядит так.
# Было: `respond / "заглушка" 200`. В Caddy такой инлайн-матчер ловит НЕ корень,
# а ВСЕ пути — и стенд начал отвечать 200 на что угодно. Приёмочный тест
# «вход верным паролем выдаёт рабочую сессию» стал ЗЕЛЁНЫМ при полном
# отсутствии кода входа. Арбитр, который врёт, хуже отсутствующего арбитра.
# Отсюда правило: блоки handle взаимно исключающие, последний — ловушка на 404.

:80 {
	encode gzip

	# Поток живых обновлений: буферизацию обязательно выключить,
	# иначе события копятся в прокси и не доезжают.
	@stream path /v1/stream*
	handle @stream {
		reverse_proxy api:3000 {
			flush_interval -1
		}
	}

	handle /v1/* {
		reverse_proxy api:3000
	}

	handle /health {
		reverse_proxy api:3000
	}

	# Точный корень: фронт встанет сюда на следующем шаге.
	@root path /
	handle @root {
		respond "Amplifie: каркас поднят. Проверка: /health" 200
	}

	# Ловушка. Всё, что не перечислено выше, обязано быть 404,
	# иначе тесты снова начнут врать.
	handle {
		respond "not found" 404
	}
}
