{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest", "--isolated"],
      "env": {}
    },
    "prometheus": {
      "command": "docker",
      "args": [
        "run", "--rm", "-i",
        "--network", "amplifie_default",
        "ghcr.io/tjhop/prometheus-mcp-server:v0.18.0",
        "--prometheus.url", "http://prometheus:9090"
      ],
      "env": {}
    }
  }
}
