# Скопируй в .env: cp .env.example .env
# .env в git не попадает (см. .gitignore)

# --- Postgres ---
POSTGRES_USER=amplifie
POSTGRES_PASSWORD=amplifie_dev_only
POSTGRES_DB=amplifie
# Порт ВНУТРИ сети compose (его видит api)
POSTGRES_PORT=5432
# Порт на хосте — для миграций, psql и приёмочных тестов.
# Не 5432: на Windows он часто уже занят или зарезервирован системой.
POSTGRES_HOST_PORT=54477

# --- API ---
# Роль приложения (НЕ владелец таблиц) — понадобится при включении RLS
DATABASE_URL=postgres://amplifie:amplifie_dev_only@postgres:5432/amplifie
API_PORT=3000
LOG_LEVEL=info
NODE_ENV=development

# --- Внешний порт (что слушает Caddy на хосте) ---
HTTP_PORT=8477

# --- Модель (появится на срезе 6, пока не нужен) ---
# ANTHROPIC_API_KEY=

# ── Модель (Р-012) ────────────────────────────────────────────────────
# Не задано — продукт работает на правилах, и это законное состояние.
#
# ПО ПОДПИСКЕ. Запускаем ВАШ официальный клиент, который уже авторизован
# вашей подпиской. Токена мы не видим и не пересылаем.
#   AMPLIFIE_MODEL=claude-cli    (нужен установленный claude и вход в него)
#   AMPLIFIE_MODEL=codex-cli     (нужен установленный codex и вход в него)
#
# ⚠️ Подписка годится ТОЛЬКО для своей установки. Обслуживать через одну
# подписку чужие команды прямо запрещено — см. Р-012.
#
# ПО КЛЮЧУ. Единственный законный путь для чужих арендаторов.
#   AMPLIFIE_MODEL=anthropic-api
#   AMPLIFIE_MODEL=openai-api
#   AMPLIFIE_MODEL_KEY=...       (ключ, не подписочный токен)
#
# Необязательное:
#   AMPLIFIE_MODEL_COMMAND=...   путь к клиенту, если он не в PATH службы
#   AMPLIFIE_MODEL_NAME=...      какая именно модель
#   AMPLIFIE_MODEL_URL=...       свой шлюз, совместимый по виду запроса
#   AMPLIFIE_MODEL_TIMEOUT_MS=120000
#
# Проверить связь: make model — спрашивает модель вживую, а не сверяет вид
# настроек. Подписочный токен живёт год и молча истекает; отличить рабочее
# подключение от истёкшего можно только настоящим вопросом.

# ── Шифрование секретов (Р-016) ───────────────────────────────────────
# Мастер-ключ, которым шифруются ключи поставщиков модели, введённые
# участниками. 32 байта в base64:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
#
# ⚠️ ПОТЕРЯ ЭТОГО КЛЮЧА = ПОТЕРЯ ВСЕХ КЛЮЧЕЙ УЧАСТНИКОВ. Восстановления
# нет и быть не может — в этом смысл. Каждый вводит свой ключ заново.
#
# ⚠️ В базу он не попадает НИКОГДА: иначе укравший дамп получает и замок,
# и ключ, и шифрование не защищает ни от чего.
#
# ⚠️ ЗДЕСЬ ПУСТО НАРОЧНО. Готовое значение в образце означало бы, что у всех
# установок один и тот же мастер-ключ, — то есть его нет. `make env`
# подставляет свой при первом запуске.
AMPLIFIE_SECRET_KEY=
# При смене ключа: новый сюда, прежний — в PREV, версию поднять на единицу.
# Смена НЕ завершена, пока PREV не убран (порядок — Р-016).
# AMPLIFIE_SECRET_KEY_VERSION=1
# AMPLIFIE_SECRET_KEY_PREV=
