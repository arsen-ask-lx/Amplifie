# --- чужие проекты для изучения -------------------------------------------
# 1.2 ГБ чужого кода (huly, plane, paperclip и другие). Лежат рядом как справочный
# материал, продуктом не являются. В историю не берём: вычистить их потом можно только
# переписыванием всей истории репозитория.
/other_project_for_example/

# --- зависимости и сборка ---------------------------------------------------
node_modules/
dist/
build/
out/
.next/
.turbo/
*.tsbuildinfo

# --- секреты ----------------------------------------------------------------
# Настройки приходят из окружения, а не из кода. В репозитории — только образец
# без единого настоящего значения.
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- логи и временное -------------------------------------------------------
*.log
npm-debug.log*
yarn-error.log*
.cache/
tmp/
coverage/
# Отчёты прогонов AQK (`probe`, `report`): пересобираются при каждом запуске.
.aqk/

# --- локальные настройки инструментов ---------------------------------------
# Общие правила проекта коммитятся (.claude/settings.json), личные — нет.
.claude/settings.local.json
.vscode/
.idea/

# --- мусор операционных систем ----------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- замечания с экрана ------------------------------------------------------
# Пишет «тыкалка» (frontend/src/dev/aim.ts) при работе руками: файл растёт
# снизу, разбирается сверху и живёт минуты. В истории от него был бы шум,
# а пользы — ноль: разобранное замечание превращается в правку кода.
dock/замечания.md

# Отчёты и следы прогонов проверок интерфейса — не код.
test-results/
playwright-report/
blob-report/
