{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "tools/checks/*.mjs",
        "tools/arbiter/*.mjs",
        "tools/dev/*.mjs",
        "tools/load/*.mjs",
        "tools/agent/trace-audit.mjs",
        "tools/agent/review-audit.mjs",
        ".claude/hooks/*.mjs"
      ],
      "project": ["tools/**/*.{mjs,ts,cjs}"],
      "ignore": ["tools/gates/**"],
      "ignoreDependencies": ["@types/react", "pg"]
    },
    "backend": {
      "entry": ["tests/**/*.test.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "frontend": {
      "entry": ["src/main.tsx", "src/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["tailwindcss"]
    },
    "bridge": {
      "project": ["src/**/*.ts"]
    },
    "packages/model": {
      "project": ["src/**/*.ts"]
    },
    "packages/contract": {
      "project": ["src/**/*.ts"]
    }
  }
}
